<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Store submission export: re-signs with the distribution
         certificate and a Mac App Store provisioning profile, producing a
         signed installer pkg. The previous method (mac-application) exported
         a development-signed app that App Store Connect rejects with error
         90283 (Invalid Provisioning Profile). -->
    <key>method</key>
    <string>app-store-connect</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>teamID</key>
    <string>5EH69Y5X38</string>
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
